  [  3] peek 0 .................................. case oState of
  [  5] pushsymb 792 ............................ <#loading>
  [  8] eq
  [  9] jmpifz [146] ............................ (case) #loading:
  [ 12] getglobal 794 ........................... <gSwScoreNetID>
  [ 15] pushint8 1 .............................. <1>
